{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SFenton/copilot-config/agent-learning.schema.json",
  "title": "Repository agent learning policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "enabled",
    "retentionDays",
    "thresholds",
    "priorities",
    "destinations",
    "automaticBuild",
    "automaticPromotion",
    "eligiblePaths",
    "excludedPaths",
    "riskClasses",
    "validators",
    "continuation",
    "promotion"
  ],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "retentionDays": { "type": "integer", "minimum": 1, "maximum": 365 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumSuccessfulWorkflows",
        "minimumDistinctSessions",
        "minimumStability",
        "maximumCandidatesPerWorkflow",
        "minimumOperationCount",
        "maximumSubgraphOperations",
        "maximumAnalysisEvents"
      ],
      "properties": {
        "minimumSuccessfulWorkflows": { "type": "integer", "minimum": 2 },
        "minimumDistinctSessions": { "type": "integer", "minimum": 2 },
        "minimumStability": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumCandidatesPerWorkflow": { "const": 1 },
        "minimumOperationCount": { "type": "integer", "minimum": 2 },
        "maximumSubgraphOperations": { "type": "integer", "minimum": 2, "maximum": 12 },
        "maximumAnalysisEvents": { "type": "integer", "minimum": 100, "maximum": 20000 }
      }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "opportunity", "class", "description", "validators", "destination"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "opportunity": { "type": "string", "minLength": 1 },
          "class": {
            "enum": [
              "deterministic-tool",
              "reusable-skill",
              "routing-policy",
              "qualification-fixture"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "validators": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "destination": { "enum": ["tools", "skills", "fixtures"] }
        }
      }
    },
    "automaticBuild": { "type": "boolean" },
    "automaticPromotion": { "const": false },
    "destinations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incubation", "tools", "skills", "fixtures"],
      "properties": {
        "incubation": { "type": "string", "minLength": 1 },
        "tools": { "type": "string", "minLength": 1 },
        "skills": { "type": "string", "minLength": 1 },
        "fixtures": { "type": "string", "minLength": 1 }
      }
    },
    "eligiblePaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "excludedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "riskClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "targets"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "knownTools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "knownSkills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedSideEffects",
        "requireReplay",
        "requireProjectValidation",
        "requireMediumReview",
        "requirePositiveValue",
        "requireScopeCheck",
        "requireRollback"
      ],
      "properties": {
        "allowedSideEffects": {
          "type": "array",
          "items": { "enum": ["none", "workspace"] }
        },
        "requireReplay": { "const": true },
        "requireProjectValidation": { "const": true },
        "requireMediumReview": { "const": true },
        "requirePositiveValue": { "const": true },
        "requireScopeCheck": { "const": true },
        "requireRollback": { "const": true }
      }
    }
  }
}
